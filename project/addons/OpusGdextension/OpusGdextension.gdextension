[configuration]

entry_symbol = "opus_gdextension_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
linux.x86_64.single.debug = "./linux/libOpusGdextension.linux.template_debug.x86_64.so"
linux.x86_64.double.debug = "./linux/libOpusGdextension.linux.template_debug.x86_64.double.so"
linux.x86_64.single.release = "./linux/libOpusGdextension.linux.template_release.x86_64.so"
linux.x86_64.double.release = "./linux/libOpusGdextension.linux.template_release.x86_64.double.so"

linux.x86_32.single.debug = "./linux/libOpusGdextension.linux.template_debug.x86_32.so"
linux.x86_32.double.debug = "./linux/libOpusGdextension.linux.template_debug.x86_32.double.so"
linux.x86_32.single.release = "./linux/libOpusGdextension.linux.template_release.x86_32.so"
linux.x86_32.double.release = "./linux/libOpusGdextension.linux.template_release.x86_32.double.so"

linux.arm64.single.debug = "./linux/libOpusGdextension.linux.template_debug.arm64.so"
linux.arm64.double.debug = "./linux/libOpusGdextension.linux.template_debug.arm64.double.so"
linux.arm64.single.release = "./linux/libOpusGdextension.linux.template_release.arm64.so"
linux.arm64.double.release = "./linux/libOpusGdextension.linux.template_release.arm64.double.so"

linux.arm32.single.debug = "./linux/libOpusGdextension.linux.template_debug.arm32.so"
linux.arm32.double.debug = "./linux/libOpusGdextension.linux.template_debug.arm32.double.so"
linux.arm32.single.release = "./linux/libOpusGdextension.linux.template_release.arm32.so"
linux.arm32.double.release = "./linux/libOpusGdextension.linux.template_release.arm32.double.so"

linux.rv64.single.debug = "./linux/libOpusGdextension.linux.template_debug.rv64.so"
linux.rv64.double.debug = "./linux/libOpusGdextension.linux.template_debug.rv64.double.so"
linux.rv64.single.release = "./linux/libOpusGdextension.linux.template_release.rv64.so"
linux.rv64.double.release = "./linux/libOpusGdextension.linux.template_release.rv64.double.so"

windows.x86_64.single.debug = "./windows/OpusGdextension.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "./windows/OpusGdextension.windows.template_debug.x86_64.double.dll"
windows.x86_64.single.release = "./windows/OpusGdextension.windows.template_release.x86_64.dll"
windows.x86_64.double.release = "./windows/OpusGdextension.windows.template_release.x86_64.double.dll"

windows.x86_32.single.debug = "./windows/OpusGdextension.windows.template_debug.x86_32.dll"
windows.x86_32.double.debug = "./windows/OpusGdextension.windows.template_debug.x86_32.double.dll"
windows.x86_32.single.release = "./windows/OpusGdextension.windows.template_release.x86_32.dll"
windows.x86_32.double.release = "./windows/OpusGdextension.windows.template_release.x86_32.double.dll"

windows.arm64.single.debug = "./windows/OpusGdextension.windows.template_debug.arm64.dll"
windows.arm64.double.debug = "./windows/OpusGdextension.windows.template_debug.arm64.double.dll"
windows.arm64.single.release = "./windows/OpusGdextension.windows.template_release.arm64.dll"
windows.arm64.double.release = "./windows/OpusGdextension.windows.template_release.arm64.double.dll"

macos.single.debug = "./macos/libOpusGdextension.macos.template_debug.dylib"
macos.double.debug = "./macos/libOpusGdextension.macos.template_debug.double.dylib"
macos.single.release = "./macos/libOpusGdextension.macos.template_release.dylib"
macos.double.release = "./macos/libOpusGdextension.macos.template_debug.double.dylib"

android.x86_64.single.debug = "./android/libOpusGdextension.android.x86_64.template_debug.so"
android.x86_64.double.debug = "./android/libOpusGdextension.android.x86_64.template_debug.double.so"
android.x86_64.single.release = "./android/libOpusGdextension.android.x86_64.template_release.so"
android.x86_64.double.release = "./android/libOpusGdextension.android.x86_64.template_release.double.so"

android.x86_32.single.debug = "./android/libOpusGdextension.android.x86_32.template_debug.so"
android.x86_32.double.debug = "./android/libOpusGdextension.android.x86_32.template_debug.double.so"
android.x86_32.single.release = "./android/libOpusGdextension.android.x86_32.template_release.so"
android.x86_32.double.release = "./android/libOpusGdextension.android.x86_32.template_release.double.so"

android.arm64.single.debug = "./android/libOpusGdextension.android.arm64.template_debug.so"
android.arm64.double.debug = "./android/libOpusGdextension.android.arm64.template_debug.double.so"
android.arm64.single.release = "./android/libOpusGdextension.android.arm64.template_release.so"
android.arm64.double.release = "./android/libOpusGdextension.android.arm64.template_release.double.so"

android.arm32.single.debug = "./android/libOpusGdextension.android.arm32.template_debug.so"
android.arm32.double.debug = "./android/libOpusGdextension.android.arm32.template_debug.double.so"
android.arm32.single.release = "./android/libOpusGdextension.android.arm32.template_release.so"
android.arm32.double.release = "./android/libOpusGdextension.android.arm32.template_release.double.so"

ios.arm64.single.debug = "./ios/libOpusGdextension.ios.template_debug.arm64.dylib"
ios.arm64.double.debug = "./ios/libOpusGdextension.ios.template_debug.arm64.double.dylib"
ios.arm64.single.release = "./ios/libOpusGdextension.ios.template_release.arm64.dylib"
ios.arm64.double.release = "./ios/libOpusGdextension.ios.template_release.arm64.double.dylib"

web.wasm32.single.debug = "./web/libOpusGdextension.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.double.debug = "./web/libOpusGdextension.web.template_release.wasm32.double.nothreads.wasm"
web.wasm32.single.release = "./web/libOpusGdextension.web.template_release.wasm32.nothreads.wasm"
web.wasm32.double.release = "./web/libOpusGdextension.web.template_release.wasm32.double.nothreads.wasm"
