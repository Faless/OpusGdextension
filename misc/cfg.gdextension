[configuration]

entry_symbol = "avif_extension_init"
compatibility_minimum = "4.3"

[libraries]

linux.debug.arm64 = "lib/LIBGDEXTENSION.linux.template_debug.arm64.so"
linux.debug.arm32 = "lib/LIBGDEXTENSION.linux.template_debug.arm32.so"
linux.debug.x86_64 = "lib/LIBGDEXTENSION.linux.template_debug.x86_64.so"
linux.debug.x86_32 = "lib/LIBGDEXTENSION.linux.template_debug.x86_32.so"
macos.debug = "lib/LIBGDEXTENSION.macos.template_debug.universal.dylib"
windows.debug.x86_64 = "lib/LIBGDEXTENSION.windows.template_debug.x86_64.dll"
windows.debug.x86_32 = "lib/LIBGDEXTENSION.windows.template_debug.x86_32.dll"
android.debug.arm64 = "lib/LIBGDEXTENSION.android.template_debug.arm64.so"
android.debug.arm32 = "lib/LIBGDEXTENSION.android.template_debug.arm32.so"
android.debug.x86_64 = "lib/LIBGDEXTENSION.android.template_debug.x86_64.so"
android.debug.x86_32 = "lib/LIBGDEXTENSION.android.template_debug.x86_32.so"
ios.debug.arm64 = "lib/LIBGDEXTENSION.ios.template_debug.arm64.dylib"
ios.debug.x86_64 = "lib/LIBGDEXTENSION.ios.template_debug.x86_64.simulator.dylib"
web.debug.threads.wasm32 = "lib/LIBGDEXTENSION.web.template_debug.wasm32.wasm"

linux.release.arm64 = "lib/LIBGDEXTENSION.linux.template_release.arm64.so"
linux.release.arm32 = "lib/LIBGDEXTENSION.linux.template_release.arm32.so"
linux.release.x86_64 = "lib/LIBGDEXTENSION.linux.template_release.x86_64.so"
linux.release.x86_32 = "lib/LIBGDEXTENSION.linux.template_release.x86_32.so"
macos.release = "lib/LIBGDEXTENSION.macos.template_release.universal.dylib"
windows.release.x86_64 = "lib/LIBGDEXTENSION.windows.template_release.x86_64.dll"
windows.release.x86_32 = "lib/LIBGDEXTENSION.windows.template_release.x86_32.dll"
android.release.arm64 = "lib/LIBGDEXTENSION.android.template_release.arm64.so"
android.release.arm32 = "lib/LIBGDEXTENSION.android.template_release.arm32.so"
android.release.x86_64 = "lib/LIBGDEXTENSION.android.template_release.x86_64.so"
android.release.x86_32 = "lib/LIBGDEXTENSION.android.template_release.x86_32.so"
ios.release.arm64 = "lib/LIBGDEXTENSION.ios.template_release.arm64.dylib"
ios.release.x86_64 = "lib/LIBGDEXTENSION.ios.template_release.x86_64.simulator.dylib"
web.release.threads.wasm32 = "lib/LIBGDEXTENSION.web.template_debug.wasm32.wasm"
